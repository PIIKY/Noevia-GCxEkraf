rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Phase 3: Reusable Hardened Global Helpers
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'vickyferdinands1@gmail.com'
      );
    }

    function isParentConsultationOwner(consultationId) {
      return exists(/databases/$(database)/documents/consultations/$(consultationId)) &&
        get(/databases/$(database)/documents/consultations/$(consultationId)).data.ownerId == request.auth.uid;
    }

    // =========================================================================
    // Validation Blueprints (Pillar 2: The "Anti-Update-Gap")
    // =========================================================================
    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.uid == userId &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.uid == userId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConsultationRecord(data, consultationId) {
      return data.keys().hasAll([
          'id',
          'ownerId',
          'title',
          'businessName',
          'businessCategory',
          'businessStage',
          'workTopic',
          'initialProblem',
          'consultationStatus',
          'currentStep',
          'businessContextMap',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'ownerId',
          'title',
          'businessName',
          'businessCategory',
          'businessStage',
          'workTopic',
          'initialProblem',
          'consultationStatus',
          'currentStep',
          'businessContextMap',
          'analysisSummaryMap',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.id == consultationId &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.businessName is string && data.businessName.size() <= 160 &&
        data.businessCategory is string && data.businessCategory.size() >= 1 && data.businessCategory.size() <= 100 &&
        data.businessStage is string && data.businessStage in ['Planning', 'Starting', 'Already Operating'] &&
        data.workTopic is string && data.workTopic in [
          'Starting a Business',
          'Marketing',
          'Finance & Pricing',
          'Operations',
          'Customer Experience',
          'Business Growth',
          'Other Challenges'
        ] &&
        data.initialProblem is string && data.initialProblem.size() <= 4000 &&
        data.consultationStatus is string && data.consultationStatus in [
          'Discovery',
          'Understanding Review',
          'Analyzed & Active',
          'Completed'
        ] &&
        data.currentStep is string && data.currentStep.size() >= 1 && data.currentStep.size() <= 64 &&
        data.businessContextMap is map && data.businessContextMap.size() <= 30 &&
        (!('analysisSummaryMap' in data) || (data.analysisSummaryMap is map && data.analysisSummaryMap.size() <= 30)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidConsultationMessage(data, consultationId, messageId) {
      return data.keys().hasAll([
          'id',
          'consultationId',
          'ownerId',
          'role',
          'content',
          'phase',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'consultationId',
          'ownerId',
          'role',
          'content',
          'phase',
          'createdAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.id == messageId &&
        data.consultationId is string && data.consultationId.size() >= 1 && data.consultationId.size() <= 128 &&
        data.consultationId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.consultationId == consultationId &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.role is string && data.role in ['user', 'assistant'] &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 15000 &&
        data.phase is string && data.phase in ['discovery', 'continuation'] &&
        data.createdAt is timestamp;
    }

    function isValidGeneratedDocumentRecord(data, consultationId, documentId) {
      return data.keys().hasAll([
          'id',
          'consultationId',
          'ownerId',
          'kind',
          'title',
          'fileName',
          'format',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'consultationId',
          'ownerId',
          'kind',
          'title',
          'fileName',
          'format',
          'createdAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.id == documentId &&
        data.consultationId is string && data.consultationId.size() >= 1 && data.consultationId.size() <= 128 &&
        data.consultationId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.consultationId == consultationId &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.kind is string && data.kind in ['consultation-report', 'action-plan', 'tailored-document'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
        data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 200 &&
        data.format is string && data.format in ['PDF', 'CSV', 'XLSX', 'DOCX'] &&
        data.createdAt is timestamp;
    }

    function isValidKnowledgeDocumentRecord(data, docId) {
      return data.keys().hasAll([
          'id',
          'documentName',
          'description',
          'category',
          'source',
          'fileType',
          'processingStatus',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'documentName',
          'description',
          'category',
          'source',
          'fileType',
          'processingStatus',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.id == docId &&
        data.documentName is string && data.documentName.size() >= 1 && data.documentName.size() <= 200 &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 1000 &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 100 &&
        data.source is string && data.source.size() >= 1 && data.source.size() <= 200 &&
        data.fileType is string && data.fileType in ['PDF', 'CSV'] &&
        data.processingStatus is string && data.processingStatus in ['Uploaded', 'Processing', 'Ready', 'Failed'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, adminUid) {
      return data.keys().hasAll(['uid', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == adminUid &&
        data.createdAt is timestamp;
    }

    // =========================================================================
    // Collection 1: /users/{userId}/public/{docId} (Non-PII Public Profile)
    // =========================================================================
    match /users/{userId}/public/{docId} {
      allow get: if isValidId(userId) && isValidId(docId) && isOwner(userId);
      allow list: if isOwner(userId) && existing().uid == request.auth.uid;
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidId(docId) &&
        isValidUserPublicProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidUserPublicProfile(incoming(), userId) &&
        isOwner(userId) &&
        isValidId(userId) &&
        isValidId(docId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
    }

    // =========================================================================
    // Collection 2: /users/{userId}/private/{docId} (PII Split Collection)
    // =========================================================================
    match /users/{userId}/private/{docId} {
      allow get: if isValidId(userId) && isValidId(docId) && isOwner(userId);
      allow list: if isOwner(userId) && existing().uid == request.auth.uid;
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        isValidId(docId) &&
        isValidUserPrivateInfo(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidUserPrivateInfo(incoming(), userId) &&
        isOwner(userId) &&
        isValidId(userId) &&
        isValidId(docId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
    }

    // =========================================================================
    // Collection 3: /consultations/{consultationId} (Private User Consultations)
    // =========================================================================
    match /consultations/{consultationId} {
      allow get: if isVerifiedUser() &&
        isValidId(consultationId) &&
        existing().ownerId == request.auth.uid;

      allow list: if isVerifiedUser() &&
        existing().ownerId == request.auth.uid;

      allow create: if isVerifiedUser() &&
        isValidId(consultationId) &&
        isValidConsultationRecord(incoming(), consultationId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidConsultationRecord(incoming(), consultationId) &&
        isVerifiedUser() &&
        isValidId(consultationId) &&
        existing().ownerId == request.auth.uid &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          // Action 1: Owner updates active consultation context, diagnosis, or progress
          (existing().consultationStatus != 'Completed' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'businessName',
              'businessCategory',
              'businessStage',
              'workTopic',
              'initialProblem',
              'consultationStatus',
              'currentStep',
              'businessContextMap',
              'analysisSummaryMap',
              'updatedAt'
            ])) ||
          // Action 2: Admin override
          isAdmin()
        );

      allow delete: if isVerifiedUser() &&
        isValidId(consultationId) &&
        existing().ownerId == request.auth.uid;

      // =======================================================================
      // Subcollection 3A: /consultations/{consultationId}/messages/{messageId}
      // =======================================================================
      match /messages/{messageId} {
        allow get: if isVerifiedUser() &&
          isValidId(consultationId) &&
          isValidId(messageId) &&
          existing().ownerId == request.auth.uid &&
          isParentConsultationOwner(consultationId);

        allow list: if isVerifiedUser() &&
          existing().ownerId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidId(consultationId) &&
          isValidId(messageId) &&
          isValidConsultationMessage(incoming(), consultationId, messageId) &&
          incoming().createdAt == request.time &&
          isParentConsultationOwner(consultationId);

        allow update: if isValidConsultationMessage(incoming(), consultationId, messageId) &&
          isVerifiedUser() &&
          isValidId(consultationId) &&
          isValidId(messageId) &&
          existing().ownerId == request.auth.uid &&
          incoming().id == existing().id &&
          incoming().consultationId == existing().consultationId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          isParentConsultationOwner(consultationId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['content']);

        allow delete: if isVerifiedUser() &&
          isValidId(consultationId) &&
          isValidId(messageId) &&
          existing().ownerId == request.auth.uid &&
          isParentConsultationOwner(consultationId);
      }

      // =======================================================================
      // Subcollection 3B: /consultations/{consultationId}/documents/{documentId}
      // =======================================================================
      match /documents/{documentId} {
        allow get: if isVerifiedUser() &&
          isValidId(consultationId) &&
          isValidId(documentId) &&
          existing().ownerId == request.auth.uid &&
          isParentConsultationOwner(consultationId);

        allow list: if isVerifiedUser() &&
          existing().ownerId == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isValidId(consultationId) &&
          isValidId(documentId) &&
          isValidGeneratedDocumentRecord(incoming(), consultationId, documentId) &&
          incoming().createdAt == request.time &&
          isParentConsultationOwner(consultationId);

        allow update: if isValidGeneratedDocumentRecord(incoming(), consultationId, documentId) &&
          isVerifiedUser() &&
          isValidId(consultationId) &&
          isValidId(documentId) &&
          existing().ownerId == request.auth.uid &&
          incoming().id == existing().id &&
          incoming().consultationId == existing().consultationId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          isParentConsultationOwner(consultationId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'fileName']);

        allow delete: if isVerifiedUser() &&
          isValidId(consultationId) &&
          isValidId(documentId) &&
          existing().ownerId == request.auth.uid &&
          isParentConsultationOwner(consultationId);
      }
    }

    // =========================================================================
    // Collection 4: /knowledge_base/{docId} (Shared Read-Only Knowledge Base)
    // =========================================================================
    match /knowledge_base/{docId} {
      allow get: if isValidId(docId);
      allow list: if existing().processingStatus == 'Ready' || isAdmin();
      allow create: if isAdmin() &&
        isValidId(docId) &&
        isValidKnowledgeDocumentRecord(incoming(), docId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidKnowledgeDocumentRecord(incoming(), docId) &&
        isAdmin() &&
        isValidId(docId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'documentName',
          'description',
          'category',
          'source',
          'fileType',
          'processingStatus',
          'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(docId);
    }

    // =========================================================================
    // Collection 5: /admins/{adminUid} (Trusted Admin Registry)
    // =========================================================================
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isAdmin() && existing().uid is string;
      allow create: if isAdmin() &&
        isValidId(adminUid) &&
        isValidAdminRecord(incoming(), adminUid) &&
        incoming().createdAt == request.time;
      allow update: if isValidAdminRecord(incoming(), adminUid) &&
        isAdmin() &&
        isValidId(adminUid) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly([]);
      allow delete: if isAdmin() && isValidId(adminUid);
    }
  }
}
